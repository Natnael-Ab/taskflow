{
  "name": "taskflow",
  "version": "0.1.0",
  "description": "A focused personal execution workspace for realistic planning and meaningful progress.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check:environment": "node scripts/verify-environment.mjs",
    "preinstall": "node scripts/verify-environment.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build",
    "verify": "npm run check:environment && npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natnael-Ab/taskflow.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Natnael-Ab/taskflow/issues"
  },
  "homepage": "https://github.com/Natnael-Ab/taskflow#readme",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.17.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0"
}
