{
  "name": "taskflow",
  "version": "0.1.0",
  "description": "A focused personal execution workspace for realistic planning and meaningful progress.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check:environment": "node scripts/verify-environment.mjs",
    "preinstall": "node scripts/verify-environment.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build",
    "verify": "npm run check:environment && npm run format:check && npm run typecheck && npm run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natnael-Ab/taskflow.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Natnael-Ab/taskflow/issues"
  },
  "homepage": "https://github.com/Natnael-Ab/taskflow#readme",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.17.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0"
}
